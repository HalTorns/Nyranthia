# Dans Coolify, saisir ces valeurs dans Environment Variables (runtime).
# Adresse du navigateur, SANS le suffixe interne :4317 du champ Domains.
NYRANTHIA_PUBLIC_URL=https://jdr.example.com
NYRANTHIA_AUTH_USER=auteur
# Renseigner un mot de passe unique d'au moins 16 caractères.
NYRANTHIA_AUTH_PASSWORD=
